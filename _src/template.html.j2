<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ p.name }} — {{ p.eyebrow }}{% if title_affiliation %}, {{ title_affiliation }}{% endif %}</title>
  <meta name="description" content="{{ p.description_meta }}">
  <link rel="canonical" href="{{ p.site_url }}">
  <meta name="author" content="{{ p.name }}">
  <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ p.name }} ({{ p.name_cn }})">
  <meta property="og:description" content="{{ p.description_meta }}">
  <meta property="og:url" content="{{ p.site_url }}">
  <meta property="og:image" content="{{ p.site_url }}assets/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
{% if x_handle %}  <meta name="twitter:site" content="{{ x_handle }}">
{% endif %}
  <link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">

  <!-- Fonts (2 families). Everything falls back to system fonts if the CDN is unreachable; icons are an inline SVG sprite. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap">
  <link rel="stylesheet" href="style.css?v={{ build_id }}">

  <script>
    /* Apply a saved theme before first paint to avoid a flash; script.js does the rest. */
    (function () {
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <script type="application/ld+json">{{ jsonld | safe }}</script>
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include 'icons.svg' %}

  <!-- ===================== NAV ===================== -->
  <header class="site-header">
    <nav class="wrap nav" aria-label="Sections">
      <a class="brand" href="#top">{{ p.name }}</a>
      <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" title="Toggle dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <ul class="nav-links" role="list">
        <li><a href="#about">About</a></li>
        <li><a href="#news">News</a></li>
        <li><a href="#publications">Publications</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#education">Education</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <!-- ===================== HERO ===================== -->
    <section class="hero wrap" aria-labelledby="site-name">
      <div class="hero-body">
        <p class="hero-eyebrow">{{ p.eyebrow }}</p>
        <h1 class="hero-name" id="site-name">{{ p.name }} <span class="name-cn" lang="zh-Hans">{{ p.name_cn }}</span></h1>
        <p class="hero-tagline">{{ p.tagline }}</p>
        <p class="hero-affil">{% for a in p.affiliations %}<a href="{{ a.url }}">{{ a.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %} · {{ p.location }}</p>
        <ul class="hero-links" role="list" aria-label="Contact and profiles">
          {%- for l in p.links %}
          <li><a class="pill" href="{{ l.url }}"{% if not l.url.startswith('mailto:') %} rel="me"{% endif %}><svg class="icon" aria-hidden="true"><use href="#{{ icon_id(l.icon) }}"/></svg>{{ l.label }}</a></li>
          {%- endfor %}
        </ul>
        <ul class="hero-chips" role="list" aria-label="Research interests">
          {%- for c in p.chips %}
          <li class="chip">{{ c }}</li>
          {%- endfor %}
        </ul>
        {%- if p.scholar_stats %}
        <p class="hero-stats"><a href="{{ scholar_url }}"><svg class="icon" aria-hidden="true"><use href="#i-scholar"/></svg><b>{{ p.scholar_stats.citations }}</b> citations · h-index <b>{{ p.scholar_stats.h_index }}</b></a> <span class="muted">(Google Scholar, {{ p.scholar_stats.as_of }})</span></p>
        {%- endif %}
      </div>
      <figure class="hero-photo">
        <img src="{{ p.photo_portrait }}"{% if photo_srcset %} srcset="{{ photo_srcset }}" sizes="(max-width: 720px) 96px, (max-width: 900px) 144px, 168px"{% endif %} alt="Portrait of {{ p.name }}" width="{{ photo_w }}" height="{{ photo_h }}" fetchpriority="high">
      </figure>
    </section>


    <!-- ===================== ABOUT ===================== -->
    <section id="about" class="section wrap" aria-labelledby="about-title">
      <div class="section-head"><h2 id="about-title">About</h2></div>
      <div class="prose">
        {%- for para in about.paragraphs %}
        <p>{{ para | safe }}</p>
        {%- endfor %}
      </div>
      <!-- INTERESTS: one <li> per research line; names link to the papers -->
      <ul class="interests" role="list" aria-label="Research interests and representative projects">
        {%- for it in about.interests %}
        <li><span class="label">{{ it.label }}</span><span class="items">{% for x in it["items"] %}<a href="{{ x.url }}">{{ x.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span></li>
        {%- endfor %}
      </ul>
    </section>

    <!-- ===================== NEWS ===================== -->
    <section id="news" class="section wrap" aria-labelledby="news-title">
      <div class="section-head"><h2 id="news-title">News</h2></div>
      <!-- NEWS: newest first. Add a new <li> at the top; the first {{ news_limit }} are shown by default. -->
      <ol class="news-list" id="news-list" role="list">
        {%- for n in news %}
        <li><time datetime="{{ n.date }}">{{ n.date_label }}</time><p>{% if n.emoji %}<span class="news-emoji" aria-hidden="true">{{ n.emoji }}</span>{% endif %}{{ n.html | safe }}</p></li>
        {%- endfor %}
      </ol>
      <button class="news-more" type="button" aria-expanded="false" aria-controls="news-list" hidden>Show all updates</button>
    </section>
    {%- if affiliation_logos %}
    <!-- ===================== LOGO STRIP ===================== -->
    <section class="logos wrap" aria-label="Affiliations and past organisations">
      <p class="logos-label">Affiliations &amp; experience</p>
      <ul class="logo-row" role="list">
        {%- for o in affiliation_logos %}
        <li><a class="logo-plate{% if o.wordmark %} is-wordmark{% endif %}" href="{{ o.url }}" title="{{ o.name }}"><img src="{{ o.logo }}" alt="{{ o.name }}" width="{{ o.w }}" height="{{ o.h }}" loading="lazy"></a></li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    <!-- ===================== PUBLICATIONS ===================== -->
    <section id="publications" class="section wrap" aria-labelledby="pubs-title">
      <div class="section-head">
        <h2 id="pubs-title">Publications</h2>
        <div class="head-aside">
          <div class="seg" role="group" aria-label="Which publications to show">
            <button type="button" data-view="selected" aria-pressed="true">Selected <span class="count">{{ pubs_meta.selected_count }}</span></button>
            <button type="button" data-view="all" aria-pressed="false">All <span class="count">{{ pubs_meta.count }}</span></button>
          </div>
        </div>
      </div>
      <p class="pubs-note"><span class="pubs-status" aria-live="polite">{{ pubs_meta.count }} papers, {{ pubs_meta.selected_count }} marked Selected.</span>
        {%- if pubs_meta.has_equal_marks or pubs_meta.has_core_marks %} <span class="pubs-legend">{% if pubs_meta.has_equal_marks %}* equal contribution{% endif %}{% if pubs_meta.has_equal_marks and pubs_meta.has_core_marks %} · {% endif %}{% if pubs_meta.has_core_marks %}† core contributors{% endif %}</span>{% endif %}
        · Full list on <a href="{{ scholar_url }}">Google Scholar</a>.</p>

      <!-- Each publication is one <article class="pub"> inside a year group. data-selected="true" shows it in the default view. -->
      {%- for group in pub_groups %}
      <div class="pub-group" data-year="{{ group.year }}">
        <h3 class="pub-year">{{ group.year }}</h3>
        {%- for pub in group.pubs %}

        <!-- PUB: {{ pub.key }} -->
        <article class="pub" id="pub-{{ pub.key }}" data-selected="{{ 'true' if pub.selected else 'false' }}">
          {%- if pub.teaser %}
          <a class="pub-figure" href="{{ pub.primary_url }}" tabindex="-1" aria-hidden="true"><img src="{{ pub.teaser }}" alt="" width="{{ pub.teaser_w }}" height="{{ pub.teaser_h }}" loading="lazy"></a>
          {%- else %}
          <div class="pub-figure is-placeholder" aria-hidden="true"><span>{{ pub.short_name }}</span></div>
          {%- endif %}
          <div class="pub-body">
            <p class="pub-meta"><span class="badge badge-venue">{{ pub.venue_short }}</span>{% if pub.distinction_badge %}<span class="badge badge-distinction">{{ pub.distinction_badge }}</span>{% endif %}{% if pub.selected %}<span class="badge badge-selected">Selected</span>{% endif %}{% if pub.highlight %}<span class="pub-highlight">{{ pub.highlight }}</span>{% endif %}</p>
            <h4 class="pub-title"><a href="{{ pub.primary_url }}">{{ pub.title }}</a></h4>
            <p class="pub-authors">{{ pub.authors_html | safe }}</p>
            <p class="pub-summary">{{ pub.summary }}</p>
            <ul class="pub-links" role="list">
              {%- for l in pub.links %}
              <li><a href="{{ l.url }}"{% if l.title %} title="{{ l.title }}"{% endif %}><svg class="icon" aria-hidden="true"><use href="#{{ l.icon }}"/></svg>{{ l.label }}</a></li>
              {%- endfor %}
            </ul>
          </div>
        </article>
        <!-- /PUB: {{ pub.key }} -->
        {%- endfor %}
      </div>
      {%- endfor %}
    </section>

    <!-- ===================== EXPERIENCE ===================== -->
    <section id="experience" class="section wrap" aria-labelledby="exp-title">
      <div class="section-head"><h2 id="exp-title">Experience</h2></div>
      <!-- EXPERIENCE: one <li class="row"> per position -->
      <ul class="rows" role="list">
        {%- for e in experience %}
        <li class="row">
          {%- if e.logo %}
          <span class="mono"><img src="{{ e.logo_square or e.logo }}" alt="" width="{{ e.logo_w }}" height="{{ e.logo_h }}" loading="lazy"></span>
          {%- else %}
          <span class="mono" aria-hidden="true">{{ e.logo_text }}</span>
          {%- endif %}
          <div class="row-body">
            <div class="row-title">{{ e.role }}</div>
            <div class="row-org"><a href="{{ e.org_url }}">{{ e.org }}</a>{% if e.where %} · {{ e.where }}{% endif %}</div>
            {%- if e.details %}
            <p class="row-details">{{ e.details | safe }}</p>
            {%- endif %}
          </div>
          {%- if e.dates %}
          <div class="row-dates">{{ e.dates }}</div>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>

    <!-- ===================== EDUCATION ===================== -->
    <section id="education" class="section wrap" aria-labelledby="edu-title">
      <div class="section-head"><h2 id="edu-title">Education</h2></div>
      <!-- EDUCATION: one <li class="row"> per degree -->
      <ul class="rows" role="list">
        {%- for e in education %}
        <li class="row">
          {%- if e.logo %}
          <span class="mono"><img src="{{ e.logo_square or e.logo }}" alt="" width="{{ e.logo_w }}" height="{{ e.logo_h }}" loading="lazy"></span>
          {%- else %}
          <span class="mono" aria-hidden="true">{{ e.logo_text }}</span>
          {%- endif %}
          <div class="row-body">
            <div class="row-title">{{ e.degree }}</div>
            <div class="row-org"><a href="{{ e.org_url }}">{{ e.org }}</a></div>
            {%- if e.details %}
            <p class="row-details">{{ e.details | safe }}</p>
            {%- endif %}
          </div>
          {%- if e.dates %}
          <div class="row-dates">{{ e.dates }}</div>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- if service %}

    <!-- ===================== SERVICE ===================== -->
    <section id="service" class="section wrap" aria-labelledby="service-title">
      <div class="section-head"><h2 id="service-title">Service</h2></div>
      <p class="service-line">{{ service.reviewing }}</p>
    </section>
    {%- endif %}
  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-row">
        <p class="footer-meta">{{ footer.copyright }} · {{ footer.updated }}</p>
        <ul class="footer-links" role="list" aria-label="Contact and profiles">
          {%- for l in p.links %}
          <li><a href="{{ l.url }}"><svg class="icon" aria-hidden="true"><use href="#{{ icon_id(l.icon) }}"/></svg>{{ 'Scholar' if l.label == 'Google Scholar' else l.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <p class="footer-credit">{{ footer.credit }} Built as plain HTML/CSS; <a href="{{ repo_url }}">source on GitHub</a>.</p>
    </div>
  </footer>

  <script src="script.js?v={{ build_id }}" defer></script>
</body>
</html>
